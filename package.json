{
  "name": "pi-xcode-mcp",
  "version": "0.5.0",
  "description": "Requires Pi 0.99+. Registers Xcode with Pi's native MCP client and adds preview, workspace, build, and diagnostics wrappers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "xcode",
    "xcode-mcp",
    "swift",
    "swiftui",
    "swiftui-preview",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorkulman/pi-xcode-mcp.git"
  },
  "homepage": "https://github.com/igorkulman/pi-xcode-mcp#readme",
  "bugs": {
    "url": "https://github.com/igorkulman/pi-xcode-mcp/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/xcode-mcp"
    ]
  },
  "scripts": {
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.0",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.9.3"
  }
}
